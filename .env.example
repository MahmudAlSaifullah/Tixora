# ---------------------------------------------------------------------------
# TIXORA environment. Copy to .env and fill in. Never commit .env.
# Only NEXT_PUBLIC_* values reach the browser; everything else stays server-side.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
DATABASE_URL="postgresql://tixora:tixora_local@localhost:5432/tixora"
# Public base URL with no trailing slash. Used for email links and gateway callbacks.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Secrets: generate each with `openssl rand -base64 48`. Use distinct values. ---
AUTH_SECRET=""
# Derives QR tokens. Changing it invalidates every issued QR code.
QR_TOKEN_SECRET=""
# Protects /api/cron/* (send as "Authorization: Bearer <secret>").
CRON_SECRET=""
# Signs sandbox gateway callbacks and guest order links.
APP_SIGNING_SECRET=""
# Set true when running behind a proxy/load balancer that sets X-Forwarded-Host.
AUTH_TRUST_HOST="true"
# Database connections per app instance.
DB_POOL_MAX="20"
# Set true on serverless hosts, and schedule /api/cron/* instead. See docs/DEPLOYMENT.md.
DISABLE_BACKGROUND_JOBS="false"

# --- Google login (optional: the button only appears when both are set) ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Booking ----------------------------------------------------------------
# Defaults only. Super admins can override these under Admin > Settings.
RESERVATION_MINUTES="10"

# --- Payments ---------------------------------------------------------------
# sandbox | live. In live mode the test adapter is refused.
PAYMENT_MODE="sandbox"
# Allows the clearly labelled test gateway. Ignored (always off) when PAYMENT_MODE=live.
PAYMENT_TEST_GATEWAY_ENABLED="true"

# SSLCommerz (cards: Visa, Mastercard, Amex; also mobile banking)
# Sandbox signup: https://developer.sslcommerz.com/registration/
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""

# bKash Tokenized Checkout (from your bKash merchant account manager)
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

# Nagad (from your Nagad merchant onboarding)
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_NUMBER=""
# Base64 body of the PEM keys, with no header/footer lines.
NAGAD_MERCHANT_PRIVATE_KEY=""
NAGAD_PUBLIC_KEY=""

# --- Email ------------------------------------------------------------------
# log | smtp | resend | none. "log" prints to the server console and writes HTML to .data/emails.
EMAIL_PROVIDER="log"
EMAIL_FROM="Tixora <no-reply@tixora.example>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""

# --- Image uploads ----------------------------------------------------------
# local | cloudinary. "local" writes to UPLOADS_DIR and suits a single server with a persistent disk.
STORAGE_PROVIDER="local"
# Defaults to .data/uploads inside the project.
UPLOADS_DIR=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
